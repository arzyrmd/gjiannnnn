{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "env": {
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_DRIVER": "file",
    "SESSION_DRIVER": "file",
    "LOG_CHANNEL": "stderr",
    "APP_DEBUG": "true"
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
